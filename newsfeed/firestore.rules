rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_data/main {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /logs/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Newsfeed: the page only READS. Writes come from the GitHub Actions collector, which
    // uses a service account and therefore bypasses these rules entirely.
    match /news/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /news_meta/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
