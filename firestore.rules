rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_data/main {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /logs/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Newsfeed events: the page only READS. Writes come from the GitHub Actions collector,
    // which uses a service account and therefore bypasses these rules entirely.
    match /news/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /news_meta/{id} {
      allow read: if true;
      allow write: if false;
    }
    // Desk votes (👍 / 👎) and push-alert device registrations: written from the page.
    match /news_feedback/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /news_devices/{token} {
      allow read: if false;
      allow write: if request.auth != null;
    }
    // Daily futures price history (2026-09-14) backing the merged net-impact + price chart. Same
    // read-only-from-the-page pattern as /news: the collector's service account writes it.
    match /prices/{product} {
      allow read: if true;
      allow write: if false;
    }
  }
}
